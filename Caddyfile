{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode zstd gzip

	# Studio and viewer API calls go to the node backend over Railway's private network,
	# so the browser sees one origin and the studio session cookie works.
	handle /api/* {
		reverse_proxy {$BACKEND_URL:http://localhost:3001}
	}

	header -Server
	header X-Content-Type-Options "nosniff"
	root * /srv

	# Hashed build files never change; a missing one is a 404, not the app page.
	handle /assets/* {
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the single-page app, so /studio/... routes load index.html.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
