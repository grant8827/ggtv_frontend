{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode zstd gzip

	# Only SRS may call the publish hooks, and it reaches the backend directly.
	handle /api/hooks/* {
		respond 404
	}

	# Studio and viewer API calls go to the node backend over Railway's private network,
	# so the browser sees one origin and the studio session cookie works.
	handle /api/* {
		reverse_proxy {$BACKEND_URL:http://localhost:3001}
	}

	# HLS video from SRS over Railway's private network, so streams play from this domain
	# (https://www.ggtvja.com/live/ggtv.m3u8). Set SRS_URL to the infra service's private
	# address, e.g. http://ggtv-infra.railway.internal:8080.
	handle /live/* {
		@playlist path *.m3u8
		header @playlist Cache-Control "no-cache"
		header Access-Control-Allow-Origin "*"
		reverse_proxy {$SRS_URL:http://localhost:8080} {
			header_down -Access-Control-Allow-Origin
			header_down -Server
		}
	}

	header -Server
	header X-Content-Type-Options "nosniff"
	root * /srv

	# Hashed build files never change; a missing one is a 404, not the app page.
	handle /assets/* {
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Caddy doesn't know this extension; browsers expect the manifest type.
	handle /manifest.webmanifest {
		header Content-Type "application/manifest+json"
		header Cache-Control "no-cache"
		file_server
	}

	# Everything else is the single-page app, so /studio/... routes load index.html.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
